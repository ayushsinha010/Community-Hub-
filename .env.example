# AI Hub configuration (all optional; the defaults below work for local development).
#
# The app reads real environment variables only. It does NOT load a .env file by
# itself, so export these in your shell (or your process manager) before starting it.
# Copy this file to .env for your own reference, but never commit the real values.

# Signs the login session cookie. If unset, a random key is generated on first start
# and stored in data/.secret_key. Set your own long random value for deployments.
# AI_HUB_SECRET_KEY=<generate-your-own-long-random-value>

# Only e-mail addresses on this domain can register.
AI_HUB_EMAIL_DOMAIN=example.com

# Comma-separated accounts that are admins (admins can post digests).
AI_HUB_ADMIN_EMAILS=admin@example.com

# Fallback label shown where a user has no department on record.
COMPANY_NAME=Your Company

# Used by `python app.py` only.
AI_HUB_PORT=5050
# 1 = Flask debug server with auto-reload (local development only), 0 = off.
AI_HUB_DEBUG=1
